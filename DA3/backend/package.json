{
  "name": "transit-management-backend",
  "version": "1.0.0",
  "description": "Express and MySQL Backend for TransitFlow Management System",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "sync:graph": "node database/sync-mysql-to-arango.js",
    "test:integration": "node --test tests/graph.integration.test.js",
    "init:graph": "node database/init-arango.js"
  },
  "dependencies": {
    "arangojs": "10.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
